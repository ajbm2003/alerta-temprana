# --- Base de datos (Railway en produccion, localhost en desarrollo) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alerta
DB_USER=postgres
DB_PASSWORD=cambiar

# Railway te da DATABASE_URL publica; descomentar en produccion y comentar lo anterior
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Registro de modelos (Hugging Face Hub, gratis) ---
HF_MODEL_REPO=tu-usuario/modelo-alerta-psicologia
HF_TOKEN=hf_xxxxxxxxxxxxxxxx   # solo si el repo es privado

# Para desarrollo local, esta ruta tiene prioridad sobre Hugging Face.
# MODEL_PATH=models/modelo_final.joblib

# Año académico COMPLETO que se puntúa; no es la ventana de entrenamiento.
# Si falta, se usa el cierre conocido del modelo/configuración.
SCORING_YEAR=2025

# /score-batch permanece deshabilitado sin este token. Crear uno propio.
# API_TOKEN=...

# --- Config general ---
RANDOM_SEED=42
