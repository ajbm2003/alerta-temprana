# Coincide con la familia de Python utilizada para guardar el pipeline.
FROM python:3.13-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY configs/ configs/
COPY sql/ sql/
# /score-batch importa scripts.predict_batch dentro del contenedor.
COPY scripts/ scripts/
RUN mkdir -p models

EXPOSE 8000
# Respeta PORT en Railway y usa 8000 al ejecutar el contenedor localmente.
CMD ["/bin/sh", "-c", "exec uvicorn src.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
